# ============================================================================
# Bodhantra Event OS — Local Environment Configuration
# ============================================================================

# Application Environment
# Controls dual-mode routing: 'local' = sandbox mode, 'production' = live Hostinger
APP_ENV=local

# Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mavericks-main
DB_USER=root
DB_PASS=aakki

# ============================================================================
# Mail Configuration (Dual-Environment)
# ============================================================================
# LOCAL MODE  (APP_ENV=local):
#   Email delivery is suppressed. OTP codes are intercepted and written to:
#     • public_html/api/logs/otp_debug.log  (persistent log file)
#     • PHP error_log / terminal output     (real-time in dev server)
#
# PRODUCTION MODE (APP_ENV=production):
#   Uses native PHP mail() routed through Hostinger's postfix MTA.
#   MAIL_FROM_ADDRESS *must* match your Hostinger domain for SPF/DKIM alignment.
# ============================================================================

MAIL_FROM_NAME="Mavericks Verification"
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_REPLY_TO=support@yourdomain.com
