# ============================================================================
# Bodhantra Event OS — Environment Configuration Template
# ============================================================================
# Copy this file to `.env` and fill in the values for your environment.
#
#   Local development:  APP_ENV=local
#   Live Hostinger:     APP_ENV=production
# ============================================================================

# Application Environment
# 'local'      → OTP codes logged to terminal + api/logs/otp_debug.log (no emails sent)
# 'production' → native PHP mail() via Hostinger postfix (real emails sent)
APP_ENV=local

# Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bodhantra_os
DB_USER=root
DB_PASS=your_mysql_root_password_here

# ============================================================================
# Mail Configuration
# ============================================================================
# These values are used for the "From" and "Reply-To" headers in production.
# On Hostinger, MAIL_FROM_ADDRESS *must* match your hosting domain name
# (e.g., no-reply@yourdomain.com) to pass SPF and DKIM checks.
#
# PRODUCTION CHECKLIST:
#   1. Replace 'yourdomain.com' with your actual Hostinger domain
#   2. Set APP_ENV=production
#   3. Ensure SPF record includes Hostinger's mail servers
#   4. Ensure DKIM is enabled in Hostinger's DNS panel
# ============================================================================

MAIL_FROM_NAME="Mavericks Verification"
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_REPLY_TO=support@yourdomain.com

# SMTP configuration variables
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your_smtp_password_here
