# ===========================================================================
# Block all HTTP access to the logs directory.
# OTP debug logs contain plaintext codes — they must NEVER be web-accessible.
# ===========================================================================
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
